{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "lib-common-angular": [
        "../lib/common-lib-angular/projects/lib-common-angular/src/public-api.ts"
      ],
      "@juliaosistem/core-dtos": [
        "../../back/lib-core-dtos/node_modules/@juliaosistem/core-dtos/index.ts",
        "node_modules/@juliaosistem/core-dtos/index.ts"
      ],
      "@juliaosistem/core-dtos/*": [
        "../../back/lib-core-dtos/node_modules/@juliaosistem/core-dtos/*",
        "node_modules/@juliaosistem/core-dtos/*"
      ],
      "@angular/*": [
        "node_modules/@angular/*"
      ],
      "@ionic/*": [
        "node_modules/@ionic/*"
      ],
      "rxjs": [
        "node_modules/rxjs"
      ],
      "rxjs/*": [
        "node_modules/rxjs/*"
      ]
    },
    
    "skipLibCheck": true,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
