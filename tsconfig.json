{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      // "@angular/core": ["node_modules/@angular/core"],
      // "@angular/common": ["node_modules/@angular/common"],
      // "@angular/platform-browser": ["node_modules/@angular/platform-browser"],
      // "@angular/platform-browser-dynamic": ["node_modules/@angular/platform-browser-dynamic"],
      // "@angular/router": ["node_modules/@angular/router"],
      "lib-common-angular": [
        "../lib/common-lib-angular/projects/lib-common-angular/src/public-api.ts"
      ],
      "@juliaosistem/core-dtos": [
        "../../back/lib-core-dtos/node_modules/@juliaosistem/core-dtos/index.ts",
        "node_modules/@juliaosistem/core-dtos/index.ts"
      ],
      "@juliaosistem/core-dtos/*": [
        "../../back/lib-core-dtos/node_modules/@juliaosistem/core-dtos/*"
      ],
      
       "juliaositembackenexpress": [
        "../../back/lib/juliaositemBackenNest/dist/index.js",
        "../../back/lib/juliaositemBackenNest/dist/index.d.ts"
      ],
      "juliaositembackenexpress/*": [
        "../../back/lib/juliaositemBackenNest/*"
      ],
      "juliaositembackenexpress/dist/*": [
        "../../back/lib/juliaositemBackenNest/dist/*"
      ],
     
      "@angular/*": [
        "node_modules/@angular/*"
      ],
      "@ngx-translate/core": [
        "node_modules/@ngx-translate/core"
      ],
      "@ngx-translate/core/*": [
        "node_modules/@ngx-translate/core/*"
      ],
      "@ngx-translate/http-loader": [
        "node_modules/@ngx-translate/http-loader"
      ],
      "@ngx-translate/http-loader/*": [
        "node_modules/@ngx-translate/http-loader/*"
      ],
      "@ionic/*": [
        "node_modules/@ionic/*"
      ],
      "rxjs": [
        "node_modules/rxjs"
      ],
      "rxjs/*": [
        "node_modules/rxjs/*"
      ],
      "country-state-city": [
        "node_modules/country-state-city"
      ],
      "country-state-city/*": [
        "node_modules/country-state-city/*"
      ],
      "libphonenumber-js": [
        "node_modules/libphonenumber-js"
      ],
      "libphonenumber-js/*": [
        "node_modules/libphonenumber-js/*"
      ]
    },
    
    "skipLibCheck": true,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
